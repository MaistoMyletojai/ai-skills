# qa-skill config — NON-SECRET values, safe to commit.
# Secrets (Trello key/token, GitHub token, tablet token, passwords) live in
# config/.secrets (gitignored). lib.sh loads this file AND .secrets.
# Loaded by scripts/lib.sh before every run.

# ───────── Repositories (this machine: ~/Documents/GitHub) ─────────
MAIN_REPO_DIR="$HOME/Documents/GitHub/dserve-backend"
WEB_REPO_DIR="$HOME/Documents/GitHub/self-service-web"
ORDERS_REPO_DIR="$HOME/Documents/GitHub/orders-dashboard"
MAIN_REPO_QA="$HOME/Documents/GitHub/dserve-backend-qa"
WEB_REPO_QA="$HOME/Documents/GitHub/self-service-web-qa"
ORDERS_REPO_QA="$HOME/Documents/GitHub/orders-dashboard-qa"
MAIN_BASE_BRANCH="master"
WEB_BASE_BRANCH="main"
ORDERS_BASE_BRANCH="main"

# GitHub slugs (remote mode).
MAIN_REPO_SLUG="MaistoMyletojai/dserve-backend"
WEB_REPO_SLUG="MaistoMyletojai/self-service-web"
ORDERS_REPO_SLUG="MaistoMyletojai/orders-dashboard"

# ───────── Trello (ids are not secrets) ─────────
TRELLO_BOARD_ID="5b86449350a1251976ad9fc4"
TRELLO_MEMBER_ID="5c65a289e527a82fc02b7e74"
TRELLO_LIST_IN_PROGRESS="5c540bbb37d75918de466d33"
TRELLO_LIST_IN_REVIEW="5b8644e257ad89672526d969"
TRELLO_LIST_QA_APPROVED=""
TRELLO_LIST_QA_REJECTED="5b8644ece0e9f149603168c5"
TRELLO_LIST_READY_FOR_PROD="6548efcdbbd249de12fcd25b"

# ───────── Ports + API targets ─────────
QA_ADMIN_PORT="5080"
QA_API_PORT="5070"
QA_ESHOP_PORT="5173"
QA_VITE_API_URL="https://ss-dev.dserve.app/api"
QA_ORDERS_PORT="3000"
QA_ORDERS_API_URL="https://ss-dev.dserve.app/api/kds"   # KdsController base

# ───────── Logins + OUR-SYSTEM credentials (NOT third-party) ─────────
# Policy: only third-party tokens (Trello/GitHub) live in config/.secrets.
# Our own test-system creds (login passwords, eshop tabletToken) are hardcoded
# here.
QA_ADMIN_EMAIL="edvardas@test.test"
QA_ADMIN_PASSWORD="DserveAi123"
QA_ORDERS_EMAIL="tauro@test.test"
QA_ORDERS_PASSWORD="dserve123"
QA_TABLET_TOKEN="54a8432a-3f4b-463b-ad32-a0d5879b738d"   # eshop tabletToken (our system)

# ───────── Deployed dev-server URLs (remote mode) ─────────
QA_ADMIN_DEV_URL="http://admin-dev.dserve.app/"
QA_ESHOP_DEV_URL="https://ss-dev.dserve.app"
QA_ORDERS_DEV_URL="http://kds-dev.dserve.app/"

# ───────── Misc ─────────
BOT_GIT_NAME="Dserve QA Bot"
BOT_GIT_EMAIL="qa-bot@dserve.local"
# Playwright runtime in the skill's OWN data root (self-contained — not the
# parent rig's). Browsers are cached globally so install is cheap.
QA_PLAYWRIGHT_RUNTIME="$HOME/dserve-qa-skill-data/playwright-runtime"
