# qa-skill SECRETS — THIRD-PARTY tokens ONLY (Trello, GitHub).
# Copy to config/.secrets and fill in. NEVER commit .secrets (it's gitignored).
# Loaded by scripts/lib.sh after config/qa-skill.env. chmod 600 recommended.
#
# NOTE: our-system credentials (login passwords, eshop tabletToken) do NOT go
# here — hardcode those in config/qa-skill.env.

# Trello REST auth (https://trello.com/app-key). Required.
TRELLO_API_KEY=
TRELLO_TOKEN=

# GitHub: prefer `gh auth login`. Only set this if the gh CLI isn't usable.
# GH_TOKEN=
