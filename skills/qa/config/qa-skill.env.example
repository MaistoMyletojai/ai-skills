# dserve-qa-runner skill — NON-SECRET configuration.
# Copy to  config/qa-skill.env  and fill in. This file is safe to commit.
# SECRETS (Trello key/token, GitHub token, tablet token, passwords) go in a
# SEPARATE gitignored file: copy config/.secrets.example → config/.secrets.
#
# Loaded by scripts/lib.sh (and trello.sh) before every run. Every key has a
# safe default in lib.sh; you only need to set the ones that differ.

# ───────── Project repositories ─────────
# Source clones (used for PR resolution via `gh pr list`).
MAIN_REPO_DIR=/Users/DSERVE/Documents/GitHub/dserve-backend
WEB_REPO_DIR=/Users/DSERVE/Documents/GitHub/self-service-web
# orders-dashboard = the web KDS (React/Vite). Some KDS tickets have their PR here.
ORDERS_REPO_DIR=/Users/DSERVE/Documents/GitHub/orders-dashboard
# QA worktrees (checked out detached per run — keep separate from your dev tree
# so QA never disturbs work-in-progress). Create with:
#   git -C "$MAIN_REPO_DIR"   worktree add "$MAIN_REPO_QA"   master
#   git -C "$WEB_REPO_DIR"    worktree add "$WEB_REPO_QA"    main
#   git -C "$ORDERS_REPO_DIR" worktree add "$ORDERS_REPO_QA" main
MAIN_REPO_QA=/Users/DSERVE/Documents/GitHub/dserve-backend-qa
WEB_REPO_QA=/Users/DSERVE/Documents/GitHub/self-service-web-qa
ORDERS_REPO_QA=/Users/DSERVE/Documents/GitHub/orders-dashboard-qa
# Base branches each repo's PRs target.
MAIN_BASE_BRANCH=master
WEB_BASE_BRANCH=main
ORDERS_BASE_BRANCH=main

# ───────── Trello ─────────
# Board to resolve numeric card refs against (resolve falls back to search).
TRELLO_BOARD_ID=
# Optional list IDs — qa_post.py moves the card by verdict when these are set.
#   QA_APPROVED            → READY_FOR_PROD (else QA_APPROVED)
#   QA_APPROVED_WITH_GATES → QA_APPROVED
#   QA_REJECTED            → QA_REJECTED (else IN_PROGRESS)
#   QA_NEEDS_HUMAN         → (card stays put)
TRELLO_LIST_READY_FOR_PROD=
TRELLO_LIST_QA_APPROVED=
TRELLO_LIST_QA_REJECTED=
TRELLO_LIST_IN_PROGRESS=
# Optional — used by some trello.sh subcommands (not required for QA).
TRELLO_MEMBER_ID=

# ───────── QA execution ─────────
QA_ADMIN_PORT=5080         # Dserve.Admin (Blazor) — NEVER 5030 (dev's port)
QA_API_PORT=5070           # SelfServiceApi
QA_ESHOP_PORT=5173         # self-service-web (Vite dev server)
QA_VITE_API_URL=https://ss-dev.dserve.app/api   # what the eshop proxies /api to

# Logins + OUR-SYSTEM creds (hardcode here; only THIRD-PARTY tokens go in .secrets).
# Blazor Admin login. Leave blank to skip the UI tier (admin-ui → code-evidence).
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
# eshop tabletToken JWT (our system) — from a logged-in staging tablet's localStorage.
QA_TABLET_TOKEN=

# orders-dashboard (KDS) — Vite port + API target + login.
# API base is the KdsController root (api/kds) — the dashboard calls
# /users/authenticate, /orders/active/{loc}, etc. RELATIVE to this.
QA_ORDERS_PORT=3000
QA_ORDERS_API_URL=https://ss-dev.dserve.app/api/kds
QA_ORDERS_EMAIL=          # KDS/venue self-service login email
QA_ORDERS_PASSWORD=

# ───────── Remote mode (no local repos) ─────────
# Used by `qa_prepare.py --remote` + the *-remote runners when the project
# repos are NOT cloned locally: resolve PR/diff from GitHub, test UI on dev.
MAIN_REPO_SLUG=MaistoMyletojai/dserve-backend
WEB_REPO_SLUG=MaistoMyletojai/self-service-web
ORDERS_REPO_SLUG=MaistoMyletojai/orders-dashboard
# Deployed dev-server URLs Playwright drives in remote mode.
QA_ADMIN_DEV_URL=          # e.g. https://admin-dev.dserve.app  (Blazor Admin on dev)
QA_ESHOP_DEV_URL=https://ss-dev.dserve.app
QA_ORDERS_DEV_URL=         # deployed KDS dashboard dev URL

# ───────── Runtime data (outside any repo, by design) ─────────
# Where runs/, logs/, and the Playwright runtime live. Default keeps the skill
# self-contained (its own data root, not the parent rig's).
QA_DATA_ROOT=/Users/DSERVE/dserve-qa-skill-data
# Defaults to $QA_DATA_ROOT/playwright-runtime. Override only to reuse an
# existing Playwright runtime elsewhere.
# QA_PLAYWRIGHT_RUNTIME=

# ───────── Agent commit identity ─────────
BOT_GIT_NAME=Dserve QA Bot
BOT_GIT_EMAIL=qa-bot@dserve.local
