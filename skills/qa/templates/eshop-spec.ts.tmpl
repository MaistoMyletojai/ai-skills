//
// Template variables:
//   {{TICKET}}      — ticket number (e.g. 4621)
//   {{N}}           — AC index, 1-based
//   {{SHORT_NAME}}  — kebab-case short name (e.g. "delivery-google-places")
//   {{AC_TEXT}}     — verbatim AC text, escaped for JS string
//   {{VIEWPORT}}    — "desktop" (1366x900) or "mobile" (390x844). Default "desktop".
//   {{TEST_BODY}}   — generated test steps
//
// The test title MUST start with "AC{{N}}: " so the orchestrator can map
// Playwright results back to the AC id.

import { test, expect, Page, devices } from "@playwright/test";

const ESHOP_URL = process.env.QA_ESHOP_URL ?? "http://localhost:5173";
const TOKEN = process.env.QA_TABLET_TOKEN ?? "";
const SHOT_DIR = process.env.QA_SCREENSHOT_DIR ?? "/tmp/qa-screenshots";

// {{VIEWPORT}} can be "desktop" or "mobile". Default desktop.
// Mobile is iPhone 14 Pro size (390x844) per knowledge base.
test.use({
  viewport: { width: 1366, height: 900 },        // desktop default
  // For mobile AC, replace the line above with:
  //   ...devices['iPhone 14 Pro'],
});

// Highlight helper — same pattern as ui-spec.ts.tmpl. Outlines the
// element(s) under test in red, scrolls into view, screenshots, then
// removes the outline. The orchestrator attaches every PNG in
// $QA_SCREENSHOT_DIR to the Trello card.
async function shotWithHighlight(
  page: Page,
  fileName: string,
  selectors: string | string[]
): Promise<void> {
  const sels = Array.isArray(selectors) ? selectors : [selectors];
  await page.evaluate((sels) => {
    for (const sel of sels) {
      const el = document.querySelector(sel) as HTMLElement | null;
      if (!el) continue;
      el.style.outline = "3px solid #ff3b30";
      el.style.outlineOffset = "2px";
      el.style.boxShadow = "0 0 0 4px rgba(255,59,48,0.25)";
      el.scrollIntoView({ block: "center", inline: "center" });
    }
  }, sels);
  await page.waitForTimeout(250);
  await page.screenshot({ path: fileName, fullPage: false });
  await page.evaluate((sels) => {
    for (const sel of sels) {
      const el = document.querySelector(sel) as HTMLElement | null;
      if (!el) continue;
      el.style.outline = "";
      el.style.outlineOffset = "";
      el.style.boxShadow = "";
    }
  }, sels);
}

// Common entry point: load the eshop with the tablet token.
// Always use this in beforeEach so every test starts from a known state.
async function loadEshop(page: Page): Promise<void> {
  await page.goto(`${ESHOP_URL}/?tabletToken=${TOKEN}`);
  await page.waitForLoadState("networkidle");
}

test.describe("Ticket #{{TICKET}} — eshop AC{{N}}", () => {
  test.beforeEach(async ({ page }) => {
    await loadEshop(page);
  });

  test("AC{{N}}: {{AC_TEXT}}", async ({ page }) => {
{{TEST_BODY}}

    // ── Visual evidence (REQUIRED) ──────────────────────────────────
    // Capture a highlighted screenshot of the verified state. The
    // orchestrator attaches this to the Trello card and the qa-runner
    // agent reads it back via Read tool for visual evaluation.
    // Replace "<selector-under-test>" with the AC's target element(s).
    await shotWithHighlight(
      page,
      `${SHOT_DIR}/eshop-ac-{{N}}-{{SHORT_NAME}}.png`,
      "<selector-under-test>"
    );
  });
});
