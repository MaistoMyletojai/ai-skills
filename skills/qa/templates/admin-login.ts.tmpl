// AUTOGENERATED by qa-runner agent — admin storage-state setup.
// Logs in to Dserve.Admin and saves session state, so all subsequent
// Playwright tests can skip the login form.
//
// Run via:
//   QA_ADMIN_URL=http://localhost:5080 \
//   QA_ADMIN_EMAIL=... \
//   QA_ADMIN_PASSWORD=... \
//   QA_ADMIN_STATE_FILE=/tmp/qa-state.json \
//   npx playwright test admin-login.spec.ts
//
// Template variables:
//   (none — the script reads everything from env)

import { test, expect } from "@playwright/test";

const ADMIN_URL = process.env.QA_ADMIN_URL ?? "http://localhost:5080";
const EMAIL = process.env.QA_ADMIN_EMAIL ?? "";
const PASSWORD = process.env.QA_ADMIN_PASSWORD ?? "";
const STATE_FILE = process.env.QA_ADMIN_STATE_FILE ?? "/tmp/qa-admin-state.json";

test("auth: login + save state", async ({ page }) => {
  if (!EMAIL || !PASSWORD) {
    throw new Error(
      "QA_ADMIN_EMAIL / QA_ADMIN_PASSWORD must be set in env"
    );
  }

  await page.goto(`${ADMIN_URL}/login`);
  await page.waitForLoadState("networkidle");

  // Radzen renders RadzenTextBox with the given Name as input[name=...].
  // The Login page uses Name="Email" and Name="Password" — see
  // Dserve.Admin/Pages/Authentication/Login.razor.
  await page.locator('input[name="Email"]').fill(EMAIL);
  await page.locator('input[name="Password"]').fill(PASSWORD);

  await Promise.all([
    page.waitForURL((url) => !url.pathname.includes("/login"), {
      timeout: 30_000,
    }),
    page.locator('button:has-text("Login")').first().click(),
  ]);

  // Some test users land on a CompanySelect page before the dashboard.
  // If it's present, pick the first company; if not, no-op.
  const companyPicker = page.locator(
    'text="Choose Company", text="Select Company"'
  );
  if (await companyPicker.first().isVisible({ timeout: 3000 }).catch(() => false)) {
    const firstSelect = page
      .locator('button:has-text("Select"), .rz-button:has-text("Select")')
      .first();
    if (await firstSelect.isVisible().catch(() => false)) {
      await Promise.all([
        page.waitForURL((url) => !url.pathname.match(/^\/(login|company|select-company)/), {
          timeout: 15_000,
        }),
        firstSelect.click(),
      ]);
    }
  }

  // Confirm we're authenticated — root should render something other
  // than the login form. We assert by absence of the password field.
  await expect(page.locator('input[name="Password"]')).toHaveCount(0);

  await page.context().storageState({ path: STATE_FILE });
});
