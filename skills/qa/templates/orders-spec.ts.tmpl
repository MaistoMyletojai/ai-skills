import { test, expect, Page } from "@playwright/test";

const ORDERS_URL = process.env.QA_ORDERS_URL ?? "http://localhost:3000";
const SHOT_DIR = process.env.QA_SCREENSHOT_DIR ?? "/tmp/qa-screenshots";

// Reuse the authenticated session (localStorage token).
test.use({ storageState: process.env.QA_ORDERS_STATE_FILE });

async function shotWithHighlight(
  page: Page,
  fileName: string,
  selectors: string | string[]
): Promise<void> {
  const sels = Array.isArray(selectors) ? selectors : [selectors];
  await page.evaluate((sels) => {
    for (const sel of sels) {
      const el = document.querySelector(sel) as HTMLElement | null;
      if (!el) continue;
      el.style.outline = "3px solid #ff3b30";
      el.style.outlineOffset = "2px";
      el.style.boxShadow = "0 0 0 4px rgba(255,59,48,0.25)";
      el.scrollIntoView({ block: "center", inline: "center" });
    }
  }, sels);
  await page.waitForTimeout(250);
  await page.screenshot({ path: fileName, fullPage: false });
  await page.evaluate((sels) => {
    for (const sel of sels) {
      const el = document.querySelector(sel) as HTMLElement | null;
      if (!el) continue;
      el.style.outline = "";
      el.style.outlineOffset = "";
      el.style.boxShadow = "";
    }
  }, sels);
}

