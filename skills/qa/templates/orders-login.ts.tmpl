// AUTOGENERATED — orders-dashboard (KDS) storage-state setup.
// Logs in to the orders-dashboard and saves session state so subsequent
// Playwright specs skip the login form. The dashboard persists its auth
// token to localStorage via redux-persist, which storageState() captures.
//
// Run via:
//   QA_ORDERS_URL=http://localhost:3000 \
//   QA_ORDERS_EMAIL=... QA_ORDERS_PASSWORD=... \
//   QA_ORDERS_STATE_FILE=/tmp/qa-orders-state.json \
//   npx playwright test orders-login.spec.ts
//
// Template variables: (none — reads everything from env)

import { test, expect } from "@playwright/test";

const ORDERS_URL = process.env.QA_ORDERS_URL ?? "http://localhost:3000";
const EMAIL = process.env.QA_ORDERS_EMAIL ?? "";
const PASSWORD = process.env.QA_ORDERS_PASSWORD ?? "";
const STATE_FILE = process.env.QA_ORDERS_STATE_FILE ?? "/tmp/qa-orders-state.json";

test("auth: orders-dashboard login + save state", async ({ page }) => {
  if (!EMAIL || !PASSWORD) {
    throw new Error("QA_ORDERS_EMAIL / QA_ORDERS_PASSWORD must be set in env");
  }

  // "/" redirects to /login when unauthenticated.
  await page.goto(`${ORDERS_URL}/login`);
  await page.waitForLoadState("networkidle");

  // MUI <TextField name="email|password"> renders input[name=...].
  await page.locator('input[name="email"]').fill(EMAIL);
  await page.locator('input[name="password"]').fill(PASSWORD);

  await Promise.all([
    // On success the app navigates to /:locationId/orders.
    page.waitForURL((url) => !url.pathname.includes("/login"), { timeout: 30_000 }),
    page.locator('button[type="submit"]').click(),
  ]);

  // Confirm we're past login (token now in localStorage).
  await expect(page.locator('input[name="password"]')).toHaveCount(0);

  await page.context().storageState({ path: STATE_FILE });
});
