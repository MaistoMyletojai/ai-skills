// Draw a colored outline around the element(s) under test, then capture a
// full screenshot. The outline makes the change pop for the human reviewer
// in Trello. `selectors` is one CSS selector or an array of them.
async function shotWithHighlight(
  page: Page,
  fileName: string,
  selectors: string | string[]
): Promise<void> {
  const sels = Array.isArray(selectors) ? selectors : [selectors];
  // Inject a high-contrast outline + a small "QA" tag on each target.
  await page.evaluate((sels) => {
    for (const sel of sels) {
      const el = document.querySelector(sel) as HTMLElement | null;
      if (!el) continue;
      el.style.outline = "3px solid #ff3b30";
      el.style.outlineOffset = "2px";
      el.style.boxShadow = "0 0 0 4px rgba(255,59,48,0.25)";
      el.scrollIntoView({ block: "center", inline: "center" });
    }
  }, sels);
  // Small settle so scroll/paint completes before the capture.
  await page.waitForTimeout(250);
  await page.screenshot({ path: `${fileName}`, fullPage: false });
  // Remove the outline so it doesn't bleed into the next AC's screenshot.
  await page.evaluate((sels) => {
    for (const sel of sels) {
      const el = document.querySelector(sel) as HTMLElement | null;
      if (!el) continue;
      el.style.outline = "";
      el.style.outlineOffset = "";
      el.style.boxShadow = "";
    }
  }, sels);
}

// elementFromPoint coverage check — copied verbatim from the knowledge
// base. Use it after rendering any new persistent UI element to detect
// z-index conflicts and hidden-behind-overlay bugs.
async function assertNotCovered(page: Page, selector: string, label: string) {
  const loc = page.locator(selector).first();
  await expect(loc, `${label}: should be visible`).toBeVisible();

  const box = await loc.boundingBox();
  if (!box) return;

  const cx = Math.round(box.x + box.width / 2);
  const cy = Math.round(box.y + box.height / 2);

  const covered = await page.evaluate(
    ([x, y, sel]: [number, number, string]) => {
      const target = document.querySelector(sel);
      const top = document.elementFromPoint(x, y);
      if (!target || !top) return false;
      return !target.contains(top) && top !== target;
    },
    [cx, cy, selector] as [number, number, string]
  );

  expect(covered, `${label}: covered by another layer — z-index conflict`).toBe(false);
}

